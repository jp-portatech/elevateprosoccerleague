# Copy to .env.local for local testing (never commit real keys).
# Use a Stripe TEST key locally; set the LIVE key only in Vercel → Settings → Environment Variables.
STRIPE_SECRET_KEY=

# Signing secret of the Stripe webhook endpoint (/api/stripe-webhook), starts with whsec_
STRIPE_WEBHOOK_SECRET=
# Resend API key for registration emails, starts with re_
RESEND_API_KEY=
